<% if flash[:error] %>
    <ul>
        <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
        <% end %>
    </ul>
<% end %>

<%= form_with model: @user do |user_form| %>
    <%= user_form.label :username, "Your user name here"%>
    <%= user_form.text_field :username%>
    <%= user_form.label :password, 'Your password here' %>
    <%= user_form.password_field :password%> 
    <%= user_form.label :email, "Your email here" %>
    <%= user_form.email_field :email, placeholder: "example@example.com" %>
    <%= user_form.submit "Create" %>
<%end%>

<button> <%= link_to "Back", users_path %> </button>